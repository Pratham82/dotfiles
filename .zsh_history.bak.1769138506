: 1737236417:0;git merge import { AppDate } from "@/common/utils/date.util";\
import { OrderEntity } from "../../domain/entity/store-detail-orders.entity";\
\
export type OrdersResponse =\
    | { result: false }\
    | {\
          data: {\
              content: OrderItemEntity[];\
              metaData: Pagination;\
              totalOrders: number;\
              totalAmount: number;\
          };\
          result: true;\
      };\
\
export type OrderItemEntity = {\
    orderId: number;\
    orderAmount: number;\
    paymentType: string;\
    noOfItems: number;\
    lat: number;\
    lon: number;\
    coordinates: {\
        lat: number;\
        lon: number;\
    };\
    dateTime: number;\
    sellerContact?: string;\
    sellerId?: number;\
    sellerName?: string;\
};\
\
export type Pagination = {\
    totalItems: number;\
    totalPages: number;\
    currentPage: number;\
    pageSize: number;\
};\
\
export const toRequest = (\
    entity: OrderEntity\
): { [key: string]: string | string[] } => {\
    console.log("ðƒ¿ƒº€ ~ entity:", entity);\
    const startDateUnix =\
        (entity.filters.createdAt?.from?.timestamp || 0) * 1000000;\
    const endDateUnix =\
        (entity.filters.createdAt?.to?.timestamp || 0) * 1000000;\
    const returnValue: { [key: string]: string | string[] } = {\
        startDateUnix: startDateUnix?.toString(),\
        endDateUnix: endDateUnix?.toString(),\
        sort: ((): string => {\
            switch (entity.sort) {\
                case "newest":\
                    return "-1";\
                case "oldest":\
                    return "1";\
            }\
        })(),\
        page: (() => {\
            switch (entity.drivers.type) {\
                case "loaded":\
                    return entity.drivers.pagination.currentPage.toString();\
                case "loading":\
                    return "1";\
                case "error":\
                    return "1";\
            }\
        })(),\
        offset: "100",\
        term: entity.filters.search ?? "",\
        // sortCol: entity.sortCol,\
        paymentType: entity?.filters?.paymentType?.selected?.id ?? "",\
\
        // sortCol: sortColMap[entity.sortCol],\
    };\
\
    return returnValue;\
};\
\
export const entityFromModel = (\
    model: OrdersResponse,\
    request: OrderEntity\
): OrderEntity => {\
    if (!model.result) {\
        return {\
            drivers: {\
                type: "loading",\
            },\
            filters: {\
                ...request.filters,\
                createdAt: {\
                    from: AppDate.now,\
                    to: AppDate.now,\
                },\
                search: "",\
                paymentType: {\
                    ...request.filters.paymentType,\
                    selected: request.filters.paymentType.selected,\
                },\
            },\
            sort: "newest",\
            // sortCol: "date",\
            tabs: {\
                options: [],\
            },\
        };\
    }\
\
    return {\
        filters: {\
            ...request.filters,\
        },\
        sort: request.sort,\
        // sortCol: request.sortCol,\
\
        drivers: {\
            list: model.data.content,\
            pagination: {\
                ...model.data.metaData,\
                itemsPerPage: model.data.metaData.pageSize,\
            },\
            totalOrders: model.data.totalOrders,\
            totalAmount: model.data.totalAmount,\
\
            type: "loaded",\
        },\
        tabs: {\
            options: [],\
        },\
    };\
};
